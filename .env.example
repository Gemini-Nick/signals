# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_TYPE=chat_id

# 微信/买点池推送
WECLAW_API_URL=http://127.0.0.1:18011
WECLAW_SEND_TO=
WECLAW_ENABLED=false
SIGNALS_INTRADAY_POOL_ALERT_ENABLED=true
SIGNALS_INTRADAY_POOL_ALERT_STRONG_CHANGE_PCT=9.5
SIGNALS_INTRADAY_POOL_ALERT_MIN_CHANGE_PCT=0
SIGNALS_INTRADAY_POOL_ALERT_MAX_PER_RUN=5

# 数据源
TUSHARE_TOKEN=
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# 产业链 AI+规则混合映射（默认复用 WeClaw openclaw HTTP agent）
# auto = WeClaw 或直接 endpoint/base_url/model 可用时启用；false = 强制只用规则兜底
SIGNALS_CHAIN_AI_ENABLED=auto
SIGNALS_CHAIN_AI_SCOPE=ambiguous
SIGNALS_CHAIN_AI_WECLAW_CONFIG=~/.weclaw/config.json
SIGNALS_CHAIN_AI_WECLAW_AGENT=openclaw
SIGNALS_CHAIN_AI_ENDPOINT=
SIGNALS_CHAIN_AI_BASE_URL=
SIGNALS_CHAIN_AI_API_KEY=
SIGNALS_CHAIN_AI_MODEL=
SIGNALS_CHAIN_AI_TIMEOUT_SECONDS=8
SIGNALS_CHAIN_AI_CACHE_TTL_SECONDS=604800

# IB Gateway (美股盘中优先)
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=1

# Alpaca (美股盘后优先，免费注册 https://app.alpaca.markets/signup)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Upstash Redis (Vercel 云端部署)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
